---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, t, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);
const base = import.meta.env.BASE_URL;
const other = locale === 'zh' ? 'en' : 'zh';
---

<BaseLayout
  locale={locale}
  description={`${dict.poemLines[0]} — ${dict.poemAttribution}`}
  langSwitchHref={`${base}${other}/`}
  currentPath="home"
>
  <section class="home-screen">
    <div class="home-copy">
      <p class="home-brand">{dict.brand}</p>
      <blockquote class="home-poem">
        {
          dict.poemLines.map((line) => (
            <p>{line}</p>
          ))
        }
      </blockquote>
      <p class="home-attr">{dict.poemAttribution}</p>
      <a class="cta" href={`${base}${locale}/figures/`}>{dict.cta}</a>
    </div>
    <figure class="home-art">
      <img
        src={`${base}home/gitanjali-1.png`}
        alt={dict.poemAttribution}
        width="1024"
        height="1024"
        decoding="async"
      />
    </figure>
  </section>
</BaseLayout>
