---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const all = await getCollection('essays');
  return all.map((entry) => {
    const [locale, ...rest] = entry.id.split('/');
    const fileSlug = rest.join('/').replace(/\.md$/, '');
    return {
      params: {
        locale,
        slug: entry.data.slug || fileSlug,
      },
      props: { entry, locale: locale as Locale },
    };
  });
}

const { entry, locale } = Astro.props;
const { Content } = await render(entry);
const dict = t(locale);
const base = import.meta.env.BASE_URL;
const other = locale === 'zh' ? 'en' : 'zh';
const { data } = entry;
---

<BaseLayout
  locale={locale}
  title={data.title}
  description={data.summary}
  langSwitchHref={`${base}${other}/essays/${data.slug}/`}
  currentPath="figures"
>
  <a class="back-link" href={`${base}${locale}/figures/${data.figure}/`}>← {dict.backToFigure}</a>
  <article class="essay">
    <p class="essay-kicker">{dict.thesis}</p>
    <h1>{data.title}</h1>
    <p class="essay-alt">{data.titleAlt}</p>
    <p class="essay-lead">{data.summary}</p>
    <div class="detail-body essay-body">
      <Content />
    </div>
  </article>
</BaseLayout>
