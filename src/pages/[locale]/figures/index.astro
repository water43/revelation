---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FigureCard from '../../../components/FigureCard.astro';
import { locales, t, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);
const base = import.meta.env.BASE_URL;
const other = locale === 'zh' ? 'en' : 'zh';

const all = await getCollection('figures');
const figures = all
  .filter((entry) => entry.id.startsWith(`${locale}/`))
  .sort((a, b) => a.data.order - b.data.order);

const categoryKeys = [
  'literary',
  'philosopher',
  'religion',
  'engineer',
  'folk',
  'decision',
] as const;
const varnaKeys = ['brahmin', 'kshatriya', 'vaishya', 'shudra'] as const;
const totalCount = figures.length;
---

<BaseLayout
  locale={locale}
  title={dict.figures}
  description={dict.tagline}
  langSwitchHref={`${base}${other}/figures/`}
  currentPath="figures"
>
  <div class="page-head">
    <h1>{dict.figures}</h1>
  </div>

  <aside
    class="filter-panel"
    data-filters
    data-result-template={dict.resultCount}
    data-total={totalCount}
  >
    <div class="filter-toolbar">
      <label class="filter-search">
        <span class="visually-hidden">{dict.searchPlaceholder}</span>
        <input
          class="search-input"
          type="search"
          data-search
          placeholder={dict.searchPlaceholder}
          autocomplete="off"
        />
      </label>
      <div class="filter-toolbar-meta">
        <p class="filter-count" data-result-count aria-live="polite">
          {dict.resultCount.replace('{n}', String(totalCount))}
        </p>
        <button type="button" class="filter-clear" data-clear hidden>
          {dict.clearFilters}
        </button>
        <div class="view-toggle" role="group" aria-label={dict.viewLabel}>
          <button type="button" class="view-btn is-active" data-view="card" aria-pressed="true">
            {dict.viewCard}
          </button>
          <button type="button" class="view-btn" data-view="list" aria-pressed="false">
            {dict.viewList}
          </button>
        </div>
      </div>
    </div>

    <div class="filter-dims">
      <fieldset class="filter-dim">
        <legend class="filter-dim-label">{dict.categoryLabel}</legend>
        <div class="filter-checks">
          {
            categoryKeys.map((key) => (
              <label class="filter-check">
                <input type="checkbox" data-category={key} />
                <span>{dict.categories[key]}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="filter-dim">
        <legend class="filter-dim-label">{dict.varnaLabel}</legend>
        <div class="filter-checks">
          {
            varnaKeys.map((key) => (
              <label class="filter-check filter-check-varna">
                <input type="checkbox" data-varna={key} />
                <span>{dict.varnas[key]}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
    </div>
  </aside>

  <ul class="figure-grid" data-figure-grid data-view="card">
    {
      figures.map((figure) => (
        <li
          data-figure-item
          data-name={`${figure.data.name} ${figure.data.nameAlt}`.toLowerCase()}
          data-categories={figure.data.categories.join(',')}
          data-varnas={figure.data.varnas.join(',')}
        >
          <FigureCard
            locale={locale}
            href={`${base}${locale}/figures/${figure.data.slug}/`}
            slug={figure.data.slug}
            name={figure.data.name}
            nameAlt={figure.data.nameAlt}
            era={figure.data.era}
            summary={figure.data.summary}
            categories={figure.data.categories}
            varnas={figure.data.varnas}
          />
        </li>
      ))
    }
  </ul>
  <p class="empty" data-empty hidden>{dict.empty}</p>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-figure-grid]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-figure-item]'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const countEl = document.querySelector<HTMLElement>('[data-result-count]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]');
  const viewBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view]'));
  const categoryInputs = Array.from(
    root?.querySelectorAll<HTMLInputElement>('input[data-category]') || [],
  );
  const varnaInputs = Array.from(
    root?.querySelectorAll<HTMLInputElement>('input[data-varna]') || [],
  );
  const storageKey = 'revelation-figure-view';
  const resultTemplate = root?.dataset.resultTemplate || '{n}';

  function selectedValues(inputs: HTMLInputElement[], attr: 'category' | 'varna') {
    return inputs
      .filter((input) => input.checked)
      .map((input) => input.dataset[attr] || '')
      .filter(Boolean);
  }

  function matchesAny(haystack: string[], selected: string[]) {
    if (selected.length === 0) return true;
    return selected.some((value) => haystack.includes(value));
  }

  function applyFilters() {
    const q = (search?.value || '').trim().toLowerCase();
    const activeCategories = selectedValues(categoryInputs, 'category');
    const activeVarnas = selectedValues(varnaInputs, 'varna');
    let visible = 0;

    for (const item of items) {
      const cats = (item.dataset.categories || '').split(',').filter(Boolean);
      const varnas = (item.dataset.varnas || '').split(',').filter(Boolean);
      const name = item.dataset.name || '';
      const catOk = matchesAny(cats, activeCategories);
      const varnaOk = matchesAny(varnas, activeVarnas);
      const qOk = !q || name.includes(q);
      const show = catOk && varnaOk && qOk;
      item.hidden = !show;
      item.classList.toggle('is-filtered-out', !show);
      if (show) visible += 1;
    }

    if (empty) empty.hidden = visible > 0;
    if (countEl) countEl.textContent = resultTemplate.replace('{n}', String(visible));
    const filtered = activeCategories.length > 0 || activeVarnas.length > 0 || Boolean(q);
    if (clearBtn) clearBtn.hidden = !filtered;
    root?.classList.toggle('has-filter', filtered);
  }

  function clearFilters() {
    categoryInputs.forEach((input) => {
      input.checked = false;
    });
    varnaInputs.forEach((input) => {
      input.checked = false;
    });
    if (search) search.value = '';
    applyFilters();
  }

  function setView(view: string) {
    const mode = view === 'list' ? 'list' : 'card';
    grid?.setAttribute('data-view', mode);
    viewBtns.forEach((btn) => {
      const on = btn.dataset.view === mode;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    try {
      localStorage.setItem(storageKey, mode);
    } catch {
      /* ignore */
    }
  }

  [...categoryInputs, ...varnaInputs].forEach((input) => {
    input.addEventListener('change', applyFilters);
  });

  clearBtn?.addEventListener('click', clearFilters);

  viewBtns.forEach((btn) => {
    btn.addEventListener('click', () => setView(btn.dataset.view || 'card'));
  });

  search?.addEventListener('input', applyFilters);

  applyFilters();

  try {
    const saved = localStorage.getItem(storageKey);
    if (saved === 'list' || saved === 'card') setView(saved);
  } catch {
    /* ignore */
  }
</script>
