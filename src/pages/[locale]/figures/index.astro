---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FigureCard from '../../../components/FigureCard.astro';
import { locales, t, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);
const base = import.meta.env.BASE_URL;
const other = locale === 'zh' ? 'en' : 'zh';

const all = await getCollection('figures');
const figures = all
  .filter((entry) => entry.id.startsWith(`${locale}/`))
  .sort((a, b) => a.data.order - b.data.order);

const functionKeys = [
  'knowledge',
  'sacred',
  'meaning',
  'order',
  'decision',
  'guard',
  'circulation',
  'enterprise',
  'production',
  'execution',
  'labor',
  'service',
] as const;

const attributeKeys = ['vaccine', 'data', 'virus'] as const;
const fieldKeys = ['temple', 'canon', 'workshop', 'market', 'land'] as const;
const stageKeys = ['rookie', 'champion', 'perfect', 'mega'] as const;

const totalCount = figures.length;
---

<BaseLayout
  locale={locale}
  title={dict.figures}
  description={dict.tagline}
  langSwitchHref={`${base}${other}/figures/`}
  currentPath="figures"
>
  <div class="page-head">
    <h1>{dict.figures}</h1>
  </div>

  <aside
    class="filter-panel"
    data-filters
    data-result-template={dict.resultCount}
    data-total={totalCount}
  >
    <div class="filter-toolbar">
      <label class="filter-search">
        <span class="visually-hidden">{dict.searchPlaceholder}</span>
        <input
          class="search-input"
          type="search"
          data-search
          placeholder={dict.searchPlaceholder}
          autocomplete="off"
        />
      </label>
      <div class="filter-toolbar-meta">
        <p class="filter-count" data-result-count aria-live="polite">
          {dict.resultCount.replace('{n}', String(totalCount))}
        </p>
        <button type="button" class="filter-clear" data-clear hidden>
          {dict.clearFilters}
        </button>
        <div class="view-toggle" role="group" aria-label={dict.viewLabel}>
          <button type="button" class="view-btn is-active" data-view="card" aria-pressed="true">
            {dict.viewCard}
          </button>
          <button type="button" class="view-btn" data-view="list" aria-pressed="false">
            {dict.viewList}
          </button>
        </div>
        <button
          type="button"
          class="filter-fold-btn"
          data-filter-fold
          data-expand-label={dict.filterExpand}
          data-collapse-label={dict.filterCollapse}
          aria-expanded="true"
          aria-controls="filter-dims"
        >
          {dict.filterCollapse}
        </button>
      </div>
    </div>

    <div class="filter-dims" id="filter-dims" data-filter-dims>
      <div class="filter-dim" role="group" aria-label={dict.functionLabel}>
        <div class="filter-dim-heading">
          <span class="filter-dim-label">{dict.functionLabel}</span>
          <button
            type="button"
            class="filter-tip-btn"
            data-tip-toggle="function"
            aria-expanded="false"
            aria-controls="filter-tip-function"
            title={dict.tipLabel}
          >
            ?
          </button>
        </div>
        <div class="filter-tip" id="filter-tip-function" data-tip="function" hidden>
          {dict.functionTip}
        </div>
        <div class="filter-checks">
          {
            functionKeys.map((key) => (
              <label class="filter-check filter-check-function">
                <input type="checkbox" data-function={key} />
                <span>{dict.functions[key]}</span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="filter-dim" role="group" aria-label={dict.attributeLabel}>
        <div class="filter-dim-heading">
          <span class="filter-dim-label">{dict.attributeLabel}</span>
          <button
            type="button"
            class="filter-tip-btn"
            data-tip-toggle="attribute"
            aria-expanded="false"
            aria-controls="filter-tip-attribute"
            title={dict.tipLabel}
          >
            ?
          </button>
        </div>
        <div class="filter-tip" id="filter-tip-attribute" data-tip="attribute" hidden>
          {dict.attributeTip}
        </div>
        <div class="filter-checks">
          {
            attributeKeys.map((key) => (
              <label class="filter-check">
                <input type="checkbox" data-attribute={key} />
                <span>{dict.attributes[key]}</span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="filter-dim" role="group" aria-label={dict.fieldLabel}>
        <div class="filter-dim-heading">
          <span class="filter-dim-label">{dict.fieldLabel}</span>
          <button
            type="button"
            class="filter-tip-btn"
            data-tip-toggle="field"
            aria-expanded="false"
            aria-controls="filter-tip-field"
            title={dict.tipLabel}
          >
            ?
          </button>
        </div>
        <div class="filter-tip" id="filter-tip-field" data-tip="field" hidden>
          {dict.fieldTip}
        </div>
        <div class="filter-checks">
          {
            fieldKeys.map((key) => (
              <label class="filter-check">
                <input type="checkbox" data-field={key} />
                <span>{dict.fields[key]}</span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="filter-dim" role="group" aria-label={dict.stageLabel}>
        <div class="filter-dim-heading">
          <span class="filter-dim-label">{dict.stageLabel}</span>
          <button
            type="button"
            class="filter-tip-btn"
            data-tip-toggle="stage"
            aria-expanded="false"
            aria-controls="filter-tip-stage"
            title={dict.tipLabel}
          >
            ?
          </button>
        </div>
        <div class="filter-tip" id="filter-tip-stage" data-tip="stage" hidden>
          {dict.stageTip}
        </div>
        <div class="filter-checks">
          {
            stageKeys.map((key) => (
              <label class="filter-check">
                <input type="checkbox" data-stage={key} />
                <span>{dict.stages[key]}</span>
              </label>
            ))
          }
        </div>
      </div>
    </div>
  </aside>

  <ul class="figure-grid" data-figure-grid data-view="card">
    {
      figures.map((figure) => (
        <li
          data-figure-item
          data-name={`${figure.data.name} ${figure.data.nameAlt}`.toLowerCase()}
          data-functions={figure.data.functions.join(',')}
          data-attribute={figure.data.attribute}
          data-field={figure.data.field}
          data-stage={figure.data.stage}
        >
          <FigureCard
            locale={locale}
            href={`${base}${locale}/figures/${figure.data.slug}/`}
            slug={figure.data.slug}
            name={figure.data.name}
            nameAlt={figure.data.nameAlt}
            era={figure.data.era}
            summary={figure.data.summary}
            functions={figure.data.functions}
            attribute={figure.data.attribute}
            field={figure.data.field}
            stage={figure.data.stage}
          />
        </li>
      ))
    }
  </ul>
  <p class="empty" data-empty hidden>{dict.empty}</p>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-figure-grid]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-figure-item]'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const countEl = document.querySelector<HTMLElement>('[data-result-count]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]');
  const viewBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view]'));
  const functionInputs = Array.from(
    root?.querySelectorAll<HTMLInputElement>('input[data-function]') || [],
  );
  const attributeInputs = Array.from(
    root?.querySelectorAll<HTMLInputElement>('input[data-attribute]') || [],
  );
  const fieldInputs = Array.from(
    root?.querySelectorAll<HTMLInputElement>('input[data-field]') || [],
  );
  const stageInputs = Array.from(
    root?.querySelectorAll<HTMLInputElement>('input[data-stage]') || [],
  );
  const tipButtons = Array.from(
    root?.querySelectorAll<HTMLButtonElement>('[data-tip-toggle]') || [],
  );
  const foldBtn = document.querySelector<HTMLButtonElement>('[data-filter-fold]');
  const dims = document.querySelector<HTMLElement>('[data-filter-dims]');
  const storageKey = 'revelation-figure-view';
  const foldStorageKey = 'revelation-filter-expanded';
  const resultTemplate = root?.dataset.resultTemplate || '{n}';
  const collapseLabel = foldBtn?.dataset.collapseLabel || 'Collapse';
  const expandLabel = foldBtn?.dataset.expandLabel || 'Expand';

  function selectedValues(
    inputs: HTMLInputElement[],
    attr: 'function' | 'attribute' | 'field' | 'stage',
  ) {
    return inputs
      .filter((input) => input.checked)
      .map((input) => input.dataset[attr] || '')
      .filter(Boolean);
  }

  function matchesAny(haystack: string[], selected: string[]) {
    if (selected.length === 0) return true;
    return selected.some((value) => haystack.includes(value));
  }

  function matchesOne(value: string, selected: string[]) {
    if (selected.length === 0) return true;
    return selected.includes(value);
  }

  function applyFilters() {
    const q = (search?.value || '').trim().toLowerCase();
    const activeFunctions = selectedValues(functionInputs, 'function');
    const activeAttributes = selectedValues(attributeInputs, 'attribute');
    const activeFields = selectedValues(fieldInputs, 'field');
    const activeStages = selectedValues(stageInputs, 'stage');
    let visible = 0;

    for (const item of items) {
      const functions = (item.dataset.functions || '').split(',').filter(Boolean);
      const attribute = item.dataset.attribute || '';
      const field = item.dataset.field || '';
      const stage = item.dataset.stage || '';
      const name = item.dataset.name || '';
      const functionOk = matchesAny(functions, activeFunctions);
      const attributeOk = matchesOne(attribute, activeAttributes);
      const fieldOk = matchesOne(field, activeFields);
      const stageOk = matchesOne(stage, activeStages);
      const qOk = !q || name.includes(q);
      const show = functionOk && attributeOk && fieldOk && stageOk && qOk;
      item.hidden = !show;
      item.classList.toggle('is-filtered-out', !show);
      if (show) visible += 1;
    }

    if (empty) empty.hidden = visible > 0;
    if (countEl) countEl.textContent = resultTemplate.replace('{n}', String(visible));
    const filtered =
      activeFunctions.length > 0 ||
      activeAttributes.length > 0 ||
      activeFields.length > 0 ||
      activeStages.length > 0 ||
      Boolean(q);
    if (clearBtn) clearBtn.hidden = !filtered;
    root?.classList.toggle('has-filter', filtered);
  }

  function clearFilters() {
    [...functionInputs, ...attributeInputs, ...fieldInputs, ...stageInputs].forEach((input) => {
      input.checked = false;
    });
    if (search) search.value = '';
    applyFilters();
  }

  function setView(view: string) {
    const mode = view === 'list' ? 'list' : 'card';
    grid?.setAttribute('data-view', mode);
    viewBtns.forEach((btn) => {
      const on = btn.dataset.view === mode;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    try {
      localStorage.setItem(storageKey, mode);
    } catch {
      /* ignore */
    }
  }

  function closeTips(except?: string) {
    tipButtons.forEach((btn) => {
      const id = btn.dataset.tipToggle || '';
      if (except && id === except) return;
      btn.setAttribute('aria-expanded', 'false');
      const panel = root?.querySelector<HTMLElement>(`[data-tip="${id}"]`);
      if (panel) panel.hidden = true;
    });
  }

  tipButtons.forEach((btn) => {
    btn.addEventListener('click', (event) => {
      event.stopPropagation();
      const id = btn.dataset.tipToggle || '';
      const panel = root?.querySelector<HTMLElement>(`[data-tip="${id}"]`);
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeTips(id);
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      if (panel) panel.hidden = open;
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node | null;
    if (target && root?.contains(target)) {
      const onTip = (target as HTMLElement).closest?.('[data-tip], [data-tip-toggle]');
      if (onTip) return;
    }
    closeTips();
  });

  [...functionInputs, ...attributeInputs, ...fieldInputs, ...stageInputs].forEach((input) => {
    input.addEventListener('change', applyFilters);
  });

  clearBtn?.addEventListener('click', clearFilters);

  viewBtns.forEach((btn) => {
    btn.addEventListener('click', () => setView(btn.dataset.view || 'card'));
  });

  search?.addEventListener('input', applyFilters);

  function setFilterExpanded(expanded: boolean) {
    root?.classList.toggle('is-collapsed', !expanded);
    if (dims) dims.hidden = !expanded;
    if (foldBtn) {
      foldBtn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      foldBtn.textContent = expanded
        ? foldBtn.dataset.collapseLabel || collapseLabel
        : foldBtn.dataset.expandLabel || expandLabel;
    }
    try {
      localStorage.setItem(foldStorageKey, expanded ? '1' : '0');
    } catch {
      /* ignore */
    }
  }

  foldBtn?.addEventListener('click', () => {
    const open = foldBtn.getAttribute('aria-expanded') === 'true';
    setFilterExpanded(!open);
    if (open) closeTips();
  });

  applyFilters();

  try {
    const saved = localStorage.getItem(storageKey);
    if (saved === 'list' || saved === 'card') setView(saved);
  } catch {
    /* ignore */
  }

  try {
    const savedFold = localStorage.getItem(foldStorageKey);
    if (savedFold === '0' || savedFold === '1') {
      setFilterExpanded(savedFold === '1');
    } else {
      const mobile = window.matchMedia('(max-width: 719px)').matches;
      setFilterExpanded(!mobile);
    }
  } catch {
    setFilterExpanded(true);
  }
</script>
