---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FigureCard from '../../../components/FigureCard.astro';
import { locales, t, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dict = t(locale);
const base = import.meta.env.BASE_URL;
const other = locale === 'zh' ? 'en' : 'zh';

const all = await getCollection('figures');
const figures = all
  .filter((entry) => entry.id.startsWith(`${locale}/`))
  .sort((a, b) => a.data.order - b.data.order);

const categoryKeys = ['literary', 'philosopher', 'religion', 'engineer', 'folk'] as const;
const varnaKeys = ['brahmin', 'kshatriya', 'vaishya', 'shudra'] as const;
---

<BaseLayout
  locale={locale}
  title={dict.figures}
  description={dict.tagline}
  langSwitchHref={`${base}${other}/figures/`}
  currentPath="figures"
>
  <div class="page-head">
    <h1>{dict.figures}</h1>
  </div>

  <div class="filters" data-filters>
    <div class="filter-row" role="group" aria-label={dict.figures}>
      <button type="button" class="filter-chip is-active" data-category="all">{dict.all}</button>
      {
        categoryKeys.map((key) => (
          <button type="button" class="filter-chip" data-category={key}>
            {dict.categories[key]}
          </button>
        ))
      }
    </div>
    <div class="filter-row" role="group" aria-label={dict.varnaLabel}>
      <span class="filter-label">{dict.varnaLabel}</span>
      <button type="button" class="filter-chip is-active" data-varna="all">{dict.all}</button>
      {
        varnaKeys.map((key) => (
          <button type="button" class="filter-chip filter-chip-varna" data-varna={key}>
            {dict.varnas[key]}
          </button>
        ))
      }
    </div>
    <input
      class="search-input"
      type="search"
      data-search
      placeholder={dict.searchPlaceholder}
      aria-label={dict.searchPlaceholder}
    />
    <div class="view-toggle" role="group" aria-label={dict.viewLabel}>
      <button type="button" class="view-btn is-active" data-view="card" aria-pressed="true">{dict.viewCard}</button>
      <button type="button" class="view-btn" data-view="list" aria-pressed="false">{dict.viewList}</button>
    </div>
  </div>

  <ul class="figure-grid" data-figure-grid data-view="card">
    {
      figures.map((figure) => (
        <li
          data-figure-item
          data-name={`${figure.data.name} ${figure.data.nameAlt}`.toLowerCase()}
          data-categories={figure.data.categories.join(',')}
          data-varnas={figure.data.varnas.join(',')}
        >
          <FigureCard
            locale={locale}
            href={`${base}${locale}/figures/${figure.data.slug}/`}
            slug={figure.data.slug}
            name={figure.data.name}
            nameAlt={figure.data.nameAlt}
            era={figure.data.era}
            summary={figure.data.summary}
            categories={figure.data.categories}
            varnas={figure.data.varnas}
          />
        </li>
      ))
    }
  </ul>
  <p class="empty" data-empty hidden>{dict.empty}</p>
</BaseLayout>

<script>
  const root = document.querySelector('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-figure-grid]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-figure-item]'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const viewBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view]'));
  let activeCategory = 'all';
  let activeVarna = 'all';
  const storageKey = 'revelation-figure-view';

  function applyFilters() {
    const q = (search?.value || '').trim().toLowerCase();
    let visible = 0;
    for (const item of items) {
      const cats = (item.dataset.categories || '').split(',');
      const varnas = (item.dataset.varnas || '').split(',');
      const name = item.dataset.name || '';
      const catOk = activeCategory === 'all' || cats.includes(activeCategory);
      const varnaOk = activeVarna === 'all' || varnas.includes(activeVarna);
      const qOk = !q || name.includes(q);
      const show = catOk && varnaOk && qOk;
      item.hidden = !show;
      if (show) visible += 1;
    }
    if (empty) empty.hidden = visible > 0;
  }

  function setView(view: string) {
    const mode = view === 'list' ? 'list' : 'card';
    grid?.setAttribute('data-view', mode);
    viewBtns.forEach((btn) => {
      const on = btn.dataset.view === mode;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    try {
      localStorage.setItem(storageKey, mode);
    } catch {
      /* ignore */
    }
  }

  root?.querySelectorAll<HTMLButtonElement>('[data-category]').forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.category || 'all';
      root.querySelectorAll('[data-category]').forEach((el) => el.classList.remove('is-active'));
      btn.classList.add('is-active');
      applyFilters();
    });
  });

  root?.querySelectorAll<HTMLButtonElement>('[data-varna]').forEach((btn) => {
    btn.addEventListener('click', () => {
      activeVarna = btn.dataset.varna || 'all';
      root.querySelectorAll('[data-varna]').forEach((el) => el.classList.remove('is-active'));
      btn.classList.add('is-active');
      applyFilters();
    });
  });

  viewBtns.forEach((btn) => {
    btn.addEventListener('click', () => setView(btn.dataset.view || 'card'));
  });

  search?.addEventListener('input', applyFilters);

  try {
    const saved = localStorage.getItem(storageKey);
    if (saved === 'list' || saved === 'card') setView(saved);
  } catch {
    /* ignore */
  }
</script>
