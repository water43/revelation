---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Portrait from '../../../components/Portrait.astro';
import { t, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const all = await getCollection('figures');
  const essays = await getCollection('essays');
  return all.map((entry) => {
    const [locale, ...rest] = entry.id.split('/');
    const fileSlug = rest.join('/').replace(/\.md$/, '');
    const slug = entry.data.slug || fileSlug;
    const linked = essays.filter(
      (essay) =>
        essay.id.startsWith(`${locale}/`) &&
        (entry.data.essays.includes(essay.data.slug) || essay.data.figure === slug),
    );
    return {
      params: {
        locale,
        slug,
      },
      props: { entry, locale: locale as Locale, linked },
    };
  });
}

const { entry, locale, linked } = Astro.props;
const { Content } = await render(entry);
const dict = t(locale);
const base = import.meta.env.BASE_URL;
const other = locale === 'zh' ? 'en' : 'zh';
const { data } = entry;
---

<BaseLayout
  locale={locale}
  title={data.name}
  description={data.summary}
  langSwitchHref={`${base}${other}/figures/${data.slug}/`}
  currentPath="figures"
>
  <a class="back-link" href={`${base}${locale}/figures/`}>← {dict.backToList}</a>
  <article class="detail">
    <div class="detail-portrait">
      <Portrait name={data.name} slug={data.slug} large />
    </div>
    <div class="detail-intro">
      <h1>{data.name}</h1>
      <p class="alt">{data.nameAlt}</p>
      <p class="era">{data.era}</p>
      <div class="tags">
        {
          data.categories.map((cat) => (
            <span class="tag">{dict.categories[cat] ?? cat}</span>
          ))
        }
      </div>
    </div>
    <div class="detail-main">
      <div class="detail-body">
        <Content />
      </div>
      {
        data.works.length > 0 && (
          <section class="works">
            <h2>{dict.works}</h2>
            <ul>
              {data.works.map((work) => (
                <li>{work}</li>
              ))}
            </ul>
          </section>
        )
      }
      {
        linked.length > 0 && (
          <section class="thesis">
            <h2>{dict.thesis}</h2>
            <ul>
              {linked.map((essay) => (
                <li>
                  <a class="thesis-link" href={`${base}${locale}/essays/${essay.data.slug}/`}>
                    <span class="thesis-link-title">{essay.data.title}</span>
                    <span class="thesis-link-summary">{essay.data.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>
