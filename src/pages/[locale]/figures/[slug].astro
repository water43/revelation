:root {
  --ink: #1c1814;
  --ink-soft: #4a433a;
  --ink-mute: #7a7266;
  --paper: #f3ece0;
  --paper-deep: #e6dcc8;
  --panel: rgba(255, 250, 242, 0.72);
  --line: rgba(28, 24, 20, 0.12);
  --accent: #8b3a2a;
  --accent-soft: #c46a4a;
  --forest: #2f4a3c;
  --shadow: 0 18px 40px rgba(28, 24, 20, 0.08);
  --radius: 2px;
  --font-display: 'Libre Baskerville', 'Noto Serif SC', Georgia, serif;
  --font-body: 'Source Sans 3', 'Noto Sans SC', system-ui, sans-serif;
  --max: 1080px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 1.05rem;
  line-height: 1.65;
  background:
    radial-gradient(ellipse 90% 60% at 10% -10%, rgba(196, 106, 74, 0.16), transparent 55%),
    radial-gradient(ellipse 70% 50% at 100% 0%, rgba(47, 74, 60, 0.12), transparent 50%),
    linear-gradient(180deg, #f7f1e6 0%, var(--paper) 45%, var(--paper-deep) 100%);
  background-attachment: fixed;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.35;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.45'/%3E%3C/svg%3E");
  mix-blend-mode: multiply;
  z-index: 0;
}

a {
  color: inherit;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;
}

a:hover {
  color: var(--accent);
}

img {
  max-width: 100%;
  display: block;
}

.site-shell {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  max-width: var(--max);
  width: 100%;
  margin: 0 auto;
  padding: 1.25rem 1.5rem;
}

.brand {
  font-family: var(--font-display);
  font-size: 1.15rem;
  letter-spacing: 0.04em;
  text-decoration: none;
}

.nav {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  font-size: 0.95rem;
}

.nav a {
  text-decoration: none;
  color: var(--ink-soft);
}

.nav a:hover,
.nav a[aria-current='page'] {
  color: var(--ink);
}

.lang-switch {
  border: 1px solid var(--line);
  background: var(--panel);
  color: var(--ink-soft);
  padding: 0.35rem 0.7rem;
  font: inherit;
  font-size: 0.85rem;
  letter-spacing: 0.04em;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.25s ease, color 0.25s ease;
}

.lang-switch:hover {
  background: var(--ink);
  color: var(--paper);
}

.site-main {
  flex: 1;
  width: 100%;
  max-width: var(--max);
  margin: 0 auto;
  padding: 0 1.5rem 4rem;
}

.site-footer {
  max-width: var(--max);
  margin: 0 auto;
  padding: 1.5rem;
  color: var(--ink-mute);
  font-size: 0.85rem;
  border-top: 1px solid var(--line);
  width: 100%;
}

/* Hero */
.hero {
  min-height: calc(100vh - 5.5rem);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 2rem 0 4rem;
  animation: rise 0.9s ease both;
}

.hero-brand {
  font-family: var(--font-display);
  font-size: clamp(3rem, 10vw, 5.5rem);
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: 0.02em;
  margin: 0 0 1.25rem;
}

.hero-tagline {
  max-width: 28rem;
  margin: 0 0 2.25rem;
  color: var(--ink-soft);
  font-size: 1.15rem;
}

.cta {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.85rem 1.4rem;
  background: var(--ink);
  color: var(--paper);
  text-decoration: none;
  font-size: 0.95rem;
  letter-spacing: 0.06em;
  transition: transform 0.25s ease, background 0.25s ease;
  width: fit-content;
}

.cta:hover {
  color: var(--paper);
  background: var(--accent);
  transform: translateY(-2px);
}

.cta::after {
  content: '→';
}

/* Figures list */
.page-head {
  padding: 2rem 0 1.5rem;
  animation: rise 0.7s ease both;
}

.page-head h1 {
  font-family: var(--font-display);
  font-size: clamp(2rem, 5vw, 2.75rem);
  margin: 0 0 0.5rem;
  font-weight: 700;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  align-items: center;
  margin: 1.5rem 0 2rem;
}

.filter-chip {
  border: 1px solid var(--line);
  background: transparent;
  color: var(--ink-soft);
  padding: 0.4rem 0.85rem;
  font: inherit;
  font-size: 0.9rem;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.2s ease;
}

.filter-chip:hover,
.filter-chip.is-active {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}

.search-input {
  flex: 1;
  min-width: 12rem;
  border: 1px solid var(--line);
  background: var(--panel);
  padding: 0.55rem 0.85rem;
  font: inherit;
  color: var(--ink);
}

.search-input:focus {
  outline: 2px solid rgba(139, 58, 42, 0.35);
  outline-offset: 1px;
}

.figure-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.25rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.figure-card {
  display: block;
  text-decoration: none;
  background: var(--panel);
  border: 1px solid var(--line);
  padding: 1.35rem 1.35rem 1.5rem;
  box-shadow: var(--shadow);
  transition: transform 0.3s ease, border-color 0.3s ease;
  animation: rise 0.7s ease both;
}

.figure-card:nth-child(2) {
  animation-delay: 0.08s;
}

.figure-card:nth-child(3) {
  animation-delay: 0.16s;
}

.figure-card:hover {
  transform: translateY(-4px);
  border-color: rgba(139, 58, 42, 0.35);
  color: inherit;
}

.figure-card .portrait {
  margin-bottom: 1rem;
}

.figure-card h2 {
  font-family: var(--font-display);
  font-size: 1.35rem;
  margin: 0 0 0.25rem;
  font-weight: 700;
}

.figure-card .alt {
  color: var(--ink-mute);
  font-size: 0.9rem;
  margin: 0 0 0.75rem;
}

.figure-card .era {
  color: var(--accent);
  font-size: 0.85rem;
  letter-spacing: 0.04em;
  margin: 0 0 0.75rem;
}

.figure-card .summary {
  color: var(--ink-soft);
  font-size: 0.95rem;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 1rem;
}

.tag {
  font-size: 0.75rem;
  letter-spacing: 0.04em;
  color: var(--forest);
  border: 1px solid rgba(47, 74, 60, 0.25);
  padding: 0.15rem 0.45rem;
}

.empty {
  color: var(--ink-mute);
  padding: 2rem 0;
}

/* Detail */
.detail {
  display: grid;
  gap: 2rem;
  padding-top: 1.5rem;
  animation: rise 0.75s ease both;
}

@media (min-width: 800px) {
  .detail {
    grid-template-columns: 240px 1fr;
    gap: 3rem;
    align-items: start;
  }
}

.detail-portrait {
  position: sticky;
  top: 1.5rem;
}

.detail-meta h1 {
  font-family: var(--font-display);
  font-size: clamp(2rem, 5vw, 3rem);
  margin: 0 0 0.35rem;
  font-weight: 700;
  line-height: 1.15;
}

.detail-meta .alt {
  color: var(--ink-mute);
  margin: 0 0 0.75rem;
  font-size: 1.05rem;
}

.detail-meta .era {
  color: var(--accent);
  letter-spacing: 0.05em;
  margin: 0 0 1rem;
}

.detail-body {
  margin-top: 1.75rem;
}

.detail-body :global(p) {
  margin: 0 0 1.1rem;
  color: var(--ink-soft);
}

.works {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--line);
}

.works h2 {
  font-family: var(--font-display);
  font-size: 1.2rem;
  margin: 0 0 0.85rem;
}

.works ul {
  margin: 0;
  padding-left: 1.1rem;
  color: var(--ink-soft);
}

.back-link {
  display: inline-block;
  margin-bottom: 1.5rem;
  color: var(--ink-mute);
  text-decoration: none;
  font-size: 0.9rem;
}

.back-link:hover {
  color: var(--accent);
}

/* Portrait */
.portrait {
  aspect-ratio: 4 / 5;
  width: 100%;
  display: grid;
  place-items: center;
  background:
    linear-gradient(145deg, rgba(47, 74, 60, 0.18), rgba(139, 58, 42, 0.22)),
    var(--paper-deep);
  border: 1px solid var(--line);
  position: relative;
  overflow: hidden;
}

.portrait::after {
  content: '';
  position: absolute;
  inset: 0.65rem;
  border: 1px solid rgba(28, 24, 20, 0.1);
  pointer-events: none;
  z-index: 1;
}

.portrait.has-image::after {
  inset: 0;
  border: none;
  box-shadow: inset 0 0 0 1px rgba(28, 24, 20, 0.08);
}

.portrait img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  filter: saturate(0.92) contrast(1.02);
}

.portrait span {
  font-family: var(--font-display);
  font-size: 3rem;
  letter-spacing: 0.08em;
  color: var(--ink);
  opacity: 0.7;
}

.detail-portrait .portrait span {
  font-size: 4.5rem;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(14px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
  }
}
