---
import Portrait from './Portrait.astro';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  href: string;
  slug: string;
  name: string;
  nameAlt: string;
  era: string;
  summary: string;
  functions: string[];
  attribute: string;
  field: string;
  stage: string;
}

const {
  locale,
  href,
  slug,
  name,
  nameAlt,
  era,
  summary,
  functions,
  attribute,
  field,
  stage,
} = Astro.props;
const dict = t(locale);
---

<a class="figure-card" href={href}>
  <Portrait name={name} slug={slug} />
  <div class="figure-card-body">
    <div class="figure-card-head">
      <h2>{name}</h2>
      <p class="alt">{nameAlt}</p>
      <p class="era">{era}</p>
    </div>
    <p class="summary">{summary}</p>
    <div class="tags">
      <span class="tag tag-stage" data-stage={stage}>{dict.stages[stage] ?? stage}</span>
      <span class="tag tag-attribute" data-attribute={attribute}>
        {dict.attributes[attribute] ?? attribute}
      </span>
      <span class="tag tag-field" data-field={field}>{dict.fields[field] ?? field}</span>
      {
        functions.map((fn) => (
          <span class="tag tag-function">{dict.functions[fn] ?? fn}</span>
        ))
      }
    </div>
  </div>
</a>
